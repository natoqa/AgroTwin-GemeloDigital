{
  "name": "agrotwin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight smartphone-based digital twin for smallholder potato farmers",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:arch": "node scripts/arch-guards.mjs",
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-boundaries": "7.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
