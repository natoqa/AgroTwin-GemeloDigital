{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // The agronomic coefficients live in JSON so the file itself is the
    // reviewable artefact (CLAUDE.md 8.2), not a TypeScript literal.
    "resolveJsonModule": true,
    "types": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*", "src/**/*.json"]
}
